# Poswiadczenia do WordPressa. Plik zyje tylko na dysku sesji, z uprawnieniami
# 600, i nigdy nie trafia do repozytorium ani na czat.
wp.creds.json
**/wp.creds.json

# Robocze zrzuty stron i renderowane podglady
lustro-*.html
lustro-*.css
lustro-media/
*.png

# Kopie tresci serwisu pobrane do analizy i pamiec podreczna zdjec
zrodla/
pamiec-zdjec/
podglad-media/

# paczki dla właściciela, budowane przez zbuduj.py
seo/whitepress/**/*.zip
# W artykułach WhitePress infografiki PNG i katalog zrodla/ (treść, skrypty, fonty) to część pracy, nie zrzuty.
!seo/whitepress/*/infografiki/*.png
!seo/whitepress/*/zrodla/
__pycache__/
